function buildForm(){
  const form = $('#casoForm');
  form.innerHTML = '';
  let sec = null;
  FIELDS.forEach(f => {
    if(f.sec !== sec){
      sec = f.sec;
      const h = document.createElement('div');
      h.className = 'form-section'; h.textContent = sec;
      form.appendChild(h);
    }
    const wrap = document.createElement('div');
    wrap.className = 'field' + (f.t === 'textarea' ? ' full' : '');
    const lab = document.createElement('label');
    lab.setAttribute('for','f_'+f.k);
    lab.innerHTML = esc(f.l) + (f.req ? ' <span class="req">*</span>' : '');
    wrap.appendChild(lab);

    let inp;
    if(f.t === 'textarea'){ inp = document.createElement('textarea'); inp.rows = 2; }
    else if(f.t === 'select'){
      inp = document.createElement('select');
      const o0 = document.createElement('option'); o0.value=''; o0.textContent='— Seleccionar —';
      inp.appendChild(o0);
      f.opts.forEach(o => { const op = document.createElement('option'); op.value=o; op.textContent=o; inp.appendChild(op); });
    } else {
      inp = document.createElement('input'); inp.type = f.t;
      if(f.t === 'number'){ inp.step = '0.01'; inp.min = '0'; }
    }
    inp.id = 'f_' + f.k;
    if(f.readonly) inp.readOnly = true;
    wrap.appendChild(inp);
    form.appendChild(wrap);
  });
  ['f_montoDemanda','f_costasTasadas','f_montoRecuperado'].forEach(id => {
    document.getElementById(id).addEventListener('input', recalc);
  });
}

function recalc(){
  const md = num($('#f_montoDemanda').value);
  const ct = num($('#f_costasTasadas').value);
  const mr = num($('#f_montoRecuperado').value);
  $('#f_totalRecuperar').value = (md + ct).toFixed(2);
  $('#f_montoPendiente').value = (md + ct - mr).toFixed(2);
}

function openForm(c){
  FIELDS.forEach(f => {
    const el = document.getElementById('f_' + f.k);
    el.value = c ? (c[f.k] ?? '') : '';
    if(f.t === 'select' && c && c[f.k]){
      const v = c[f.k];
      if(![...el.options].some(o=>o.value===v)){
        const o = document.createElement('option'); o.value=v; o.textContent=v; el.appendChild(o);
      }
      el.value = v;
    }
  });
  editId = c ? c.id : null;
  $('#formTitle').textContent = c ? '✎ Editar caso — ' + (c.nombreDeudor || '') : '＋ Nuevo caso';
  recalc();
  $('#formModal').classList.add('show');
}

function saveCaso(){
  const nombre = $('#f_nombreDeudor').value.trim();
  if(!nombre){ toast('⚠ El nombre del deudor es obligatorio'); $('#f_nombreDeudor').focus(); return; }
  const data = { id: editId || ('c' + Date.now() + Math.random().toString(36).slice(2,7)) };
  FIELDS.forEach(f => { data[f.k] = document.getElementById('f_' + f.k).value; });
  if(editId){
    const i = casos.findIndex(c => c.id === editId);
    if(i > -1) casos[i] = data;
    toast('✔ Caso actualizado');
  } else {
    casos.unshift(data);
    toast('✔ Caso registrado');
  }
  guardar(); render(); renderSucursales(); closeModals();
}

