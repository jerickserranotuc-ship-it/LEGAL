function buildHead(){
  const tr = $('#theadRow');
  tr.innerHTML = '';
  COLS.forEach(c => {
    const th = document.createElement('th');
    th.dataset.key = c.k;
    th.innerHTML = esc(c.l) + ' <span class="arw">⇅</span>';
    th.addEventListener('click', () => {
      if(sortKey === c.k) sortDir *= -1; else { sortKey = c.k; sortDir = 1; }
      render();
    });
    tr.appendChild(th);
  });
  const thA = document.createElement('th');
  thA.textContent = 'Acciones';
  thA.style.cursor = 'default';
  tr.appendChild(thA);
}

function getFiltered(){
  const q  = $('#search').value.trim().toLowerCase();
  const fe = $('#filterEstatus').value;
  const fa = $('#filterAbogado').value;
  const fs = $('#filterSucursal').value;
  return casos.filter(c => {
    if(fe && c.estatus !== fe) return false;
    if(fa && c.abogado !== fa) return false;
    if(fs && (c.sucursal||'').toUpperCase() !== fs.toUpperCase()) return false;
    if(q){
      const blob = FIELDS.map(f => c[f.k] || '').join(' ').toLowerCase();
      if(!blob.includes(q)) return false;
    }
    return true;
  });
}

function fillFilter(sel, key, upper){
  const el = $(sel);
  const prev = el.value;
  let vals = [...new Set(casos.map(c => c[key]).filter(v => v && String(v).trim()))];
  if(upper) vals = vals.map(v=>v.toUpperCase());
  vals = [...new Set(vals)].sort((a,b)=>String(a).localeCompare(String(b)));
  const label = el.options[0].textContent.split(':')[0];
  el.innerHTML = `<option value="">${label}: todos</option>`;
  vals.forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; el.appendChild(o); });
  if(vals.includes(prev)) el.value = prev;
}

function render(){
  fillFilter('#filterEstatus','estatus');
  fillFilter('#filterAbogado','abogado');
  fillFilter('#filterSucursal','sucursal', true);

  let rows = getFiltered();
  if(sortKey){
    rows.sort((a,b) => {
      let va, vb;
      if(sortKey === '_pendiente'){ va = calc(a).pendiente; vb = calc(b).pendiente; }
      else if(COLS.find(c => c.k===sortKey)?.money){ va = num(a[sortKey]); vb = num(b[sortKey]); }
      else { va = String(a[sortKey]||'').toLowerCase(); vb = String(b[sortKey]||'').toLowerCase(); }
      if(va < vb) return -1*sortDir;
      if(va > vb) return 1*sortDir;
      return 0;
    });
  }

  const tb = $('#tbody');
  tb.innerHTML = '';
  const frag = document.createDocumentFragment();

  rows.forEach(c => {
    const k = calc(c);
    const tr = document.createElement('tr');
    COLS.forEach(col => {
      const td = document.createElement('td');
      if(col.k === '_pendiente'){ td.textContent = fmtN(k.pendiente); td.classList.add('num'); }
      else if(col.money){ td.textContent = fmtN(c[col.k]); td.classList.add('num'); }
      else if(col.date){ td.textContent = fmtDate(c[col.k]); }
      else if(col.badge){
        const e = c[col.k] || '—';
        td.innerHTML = `<span class="badge ${badgeClass(e)}">${esc(e)}</span>`;
      }
      else td.textContent = c[col.k] || '—';
      tr.appendChild(td);
    });

    const tdA = document.createElement('td');
    tdA.innerHTML = `<div class="actions">
        <button class="icon-btn" title="Ver detalle" data-act="ver">👁</button>
        <button class="icon-btn" title="Editar" data-act="editar">✎</button>
        <button class="icon-btn" title="Eliminar" data-act="eliminar">🗑</button>
      </div>`;
    tdA.querySelector('[data-act="ver"]').onclick      = () => verCaso(c.id);
    tdA.querySelector('[data-act="editar"]').onclick   = () => openForm(c);
    tdA.querySelector('[data-act="eliminar"]').onclick = () => eliminarCaso(c.id);
    tr.appendChild(tdA);
    frag.appendChild(tr);
  });
  tb.appendChild(frag);

  $('#emptyMsg').style.display = rows.length ? 'none' : 'block';
  $('#tabla').style.display   = rows.length ? 'table' : 'none';

  renderStats();
  $('#headerCount').textContent = casos.length + (casos.length === 1 ? ' caso' : ' casos');
}

function renderStats(){
  let md = 0, tot = 0, rec = 0;
  casos.forEach(c => { const k = calc(c); md += k.md; tot += k.total; rec += k.mr; });
  $('#sCasos').textContent   = casos.length.toLocaleString('es');
  $('#sDemanda').textContent = fmtN(md);
  $('#sTotal').textContent   = fmtN(tot);
  $('#sRecup').textContent   = fmtN(rec);
  $('#sPend').textContent    = fmtN(tot - rec);
  $('#sPct').textContent     = tot > 0 ? ((rec / tot) * 100).toFixed(1) + '%' : '0%';
}

/* ============================================================
   VER / ELIMINAR
   ============================================================ */
function verCaso(id){
  const c = casos.find(x => x.id === id);
  if(!c) return;
  viewId = id;
  const body = $('#viewBody');
  body.innerHTML = '';
  let sec = null;
  FIELDS.forEach(f => {
    if(f.sec !== sec){
      sec = f.sec;
      const h = document.createElement('div');
      h.className = 'detail-sec'; h.textContent = sec;
      body.appendChild(h);
    }
    const d = document.createElement('div');
    d.className = 'd-item';
    let v = c[f.k];
    if(f.t === 'date') v = fmtDate(v);
    else if(f.t === 'number') v = (v !== '' && v != null) ? fmtN(v) : '—';
    else v = (v && String(v).trim()) ? v : '—';
    d.innerHTML = `<div class="k">${esc(f.l)}</div><div class="v">${esc(v)}</div>`;
    body.appendChild(d);
  });
  $('#viewTitle').textContent = '📄 ' + (c.nombreDeudor || 'Caso') + (c.noAsuntoJudicial ? ' · ' + c.noAsuntoJudicial : '');
  $('#viewModal').classList.add('show');
}

function eliminarCaso(id){
  const c = casos.find(x => x.id === id);
  if(!c) return;
  if(!confirm(`¿Eliminar definitivamente el caso de "${c.nombreDeudor}"?`)) return;
  casos = casos.filter(x => x.id !== id);
  guardar(); render(); renderSucursales(); toast('🗑 Caso eliminado');
}

