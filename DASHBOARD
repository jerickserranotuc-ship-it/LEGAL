const dz = $('#dropzone');
['dragenter','dragover'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.add('over'); }));
['dragleave','drop'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove('over'); }));
dz.addEventListener('drop', e => {
  const f = e.dataTransfer.files && e.dataTransfer.files[0];
  if(f) handleExcelFile(f);
});

$('#btnBorrarTodo').onclick = () => {
  if(!casos.length) return toast('⚠ No hay casos');
  if(!confirm('¿Eliminar TODOS los casos? Esta acción es irreversible.')) return;
  casos = []; sucursalSel = null; guardar(); render(); renderSucursales(); toast('🗑 Base vaciada');
};

$('#viewEdit').onclick = () => {
  const c = casos.find(x => x.id === viewId);
  closeModals();
  if(c) setTimeout(() => openForm(c), 120);
};

['#search','#filterEstatus','#filterAbogado','#filterSucursal'].forEach(s => {
  $(s).addEventListener('input', () => {
    // Si el usuario cambia manualmente el filtro de sucursal, sincronizamos el panel
    if(s === '#filterSucursal'){
      const v = $('#filterSucursal').value;
      sucursalSel = v ? v.toUpperCase() : null;
      renderSucursales();
    }
    render();
  });
  $(s).addEventListener('change', () => {
    if(s === '#filterSucursal'){
      const v = $('#filterSucursal').value;
      sucursalSel = v ? v.toUpperCase() : null;
      renderSucursales();
    }
    render();
  });
});

