function agruparPorSucursal(){
  const grupos = {};
  casos.forEach(c => {
    const suc = (c.sucursal || 'SIN SUCURSAL').trim().toUpperCase() || 'SIN SUCURSAL';
    if(!grupos[suc]) grupos[suc] = {
      nombre: suc, casos: [],
      md:0, ct:0, total:0, rec:0, pend:0,
      estatus:{}, abogados:{}, statusTrabajo:{}, tipoJuicio:{}, juzgados:{},
      deudores:new Set(), recuperadosFull:0, activos:0, cancelados:0, embargos:0, noLabora:0
    };
    const g = grupos[suc];
    const k = calc(c);
    g.casos.push(c);
    g.md += k.md; g.ct += k.ct; g.total += k.total; g.rec += k.mr; g.pend += k.pendiente;
    g.deudores.add((c.nombreDeudor||'').trim().toUpperCase());
    const est = (c.estatus||'SIN ESTATUS').trim();
    g.estatus[est] = (g.estatus[est]||0) + 1;
    const ab = (c.abogado||'SIN ASIGNAR').trim();
    g.abogados[ab] = (g.abogados[ab]||0) + 1;
    const st = (c.statusTrabajo||'DESCONOCIDO').trim();
    g.statusTrabajo[st] = (g.statusTrabajo[st]||0) + 1;
    const tj = (c.tipoJuicio||'SIN TIPO').trim();
    g.tipoJuicio[tj] = (g.tipoJuicio[tj]||0) + 1;
    const jz = (c.juzgado||'SIN JUZGADO').trim();
    g.juzgados[jz] = (g.juzgados[jz]||0) + 1;
    const e = est.toLowerCase();
    if(e.includes('cancel')||e.includes('cerr')) g.cancelados++;
    else if(e.includes('embargo')||e.includes('ejecuc')) g.embargos++;
    if(e.includes('activo')||e.includes('trámite')||e.includes('tramite')||e.includes('recuper')) g.activos++;
    if((st||'').toUpperCase().includes('NO LABORA')) g.noLabora++;
  });
  return grupos;
}

