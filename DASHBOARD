function exportCSVDe(lista, nombre){
  if(!lista.length) return toast('⚠ No hay casos');
  const heads = FIELDS.map(f => f.l).concat(['TOTAL A RECUPERAR (calc.)','PENDIENTE (calc.)']);
  const rows = lista.map(c => {
    const k = calc(c);
    return FIELDS.map(f => `"${String(c[f.k] ?? '').replace(/"/g,'""').replace(/\r?\n/g,' ')}"`)
      .concat([k.total.toFixed(2), k.pendiente.toFixed(2)]);
  });
  const csv = '\uFEFF' + [heads.map(h=>`"${h}"`).join(';')].concat(rows.map(r => r.join(';'))).join('\r\n');
  const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = (nombre||'casos') + '_' + new Date().toISOString().slice(0,10) + '.csv';
  a.click(); URL.revokeObjectURL(a.href);
  toast('⬇ CSV exportado');
}
function exportCSV(){ exportCSVDe(getFiltered(), 'casos_judiciales'); }

function exportJSON(){
  if(!casos.length) return toast('⚠ No hay casos');
  const blob = new Blob([JSON.stringify(casos, null, 2)], {type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'respaldo_casos_' + new Date().toISOString().slice(0,10) + '.json';
  a.click(); URL.revokeObjectURL(a.href);
  toast('⬇ Respaldo generado');
}

function importJSON(file){
  const r = new FileReader();
  r.onload = ev => {
    try{
      const data = JSON.parse(ev.target.result);
      if(!Array.isArray(data)) throw new Error('Formato inválido');
      const ids = new Set(casos.map(c => c.id));
      let n = 0;
      data.forEach(d => {
        if(!d.id || ids.has(d.id)) d.id = 'c' + Date.now() + Math.random().toString(36).slice(2,7);
        casos.push(d); n++;
      });
      guardar(); render(); renderSucursales(); toast(`⬆ ${n} casos importados`);
    }catch(err){ alert('No se pudo importar: ' + err.message); }
  };
  r.readAsText(file);
}

/* ============================================================
   IMPORTAR EXCEL
   ============================================================ */
function normHeader(s){
  return String(s == null ? '' : s)
    .toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .replace(/[°º]/g,'').replace(/\s+/g,' ').trim();
}
const HEADER_LOOKUP = (() => {
  const map = {};
  Object.keys(FIELD_ALIASES).forEach(field => {
    FIELD_ALIASES[field].forEach(alias => { map[normHeader(alias)] = field; });
  });
  return map;
})();

function excelDateToISO(val){
  if(val == null || val === '') return '';
  if(val instanceof Date){
    if(isNaN(val)) return '';
    const pad = n => String(n).padStart(2,'0');
    return `${val.getFullYear()}-${pad(val.getMonth()+1)}-${pad(val.getDate())}`;
  }
  if(typeof val === 'number'){
    const days = Math.round(val);
    if(days < 1) return '';
    const d = new Date(Date.UTC(1899,11,30) + days*86400000);
    if(isNaN(d)) return '';
    const pad = n => String(n).padStart(2,'0');
    return `${d.getUTCFullYear()}-${pad(d.getUTCMonth()+1)}-${pad(d.getUTCDate())}`;
  }
  const s = String(val).trim();
  if(!s || s === '#N/A' || s === 'N/A') return '';
  let m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})/);
  if(m){
    let [_,a,b,c] = m;
    if(c.length===2) c = '20'+c;
    return `${c}-${b.padStart(2,'0')}-${a.padStart(2,'0')}`;
  }
  m = s.match(/^(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})/);
  if(m) return `${m[1]}-${m[2].padStart(2,'0')}-${m[3].padStart(2,'0')}`;
  return s;
}
function cleanString(v){
  if(v == null) return '';
  const s = String(v).trim();
  if(s === '#N/A' || s === 'N/A' || s === '-' || s === '#¡VALOR!' || s === '#DIV/0!' || s === '#REF!') return '';
  return s;
}
function findHeaderRow(aoa){
  let bestRow = -1, bestCount = 0;
  const limit = Math.min(aoa.length, 20);
  for(let i = 0; i < limit; i++){
    const row = aoa[i] || [];
    let count = 0;
    for(const cell of row){
      const h = normHeader(cell);
      if(HEADER_LOOKUP[h]) count++;
    }
    if(count > bestCount){ bestCount = count; bestRow = i; }
  }
  return { rowIdx: bestRow, count: bestCount };
}

function sheetToCasos(sheet){
  const aoa = XLSX.utils.sheet_to_json(sheet, { header:1, raw:true, defval:'', blankrows:false });
  if(!aoa.length) return { rows: [], headerIdx: -1, cols: 0 };
  const { rowIdx, count } = findHeaderRow(aoa);
  if(rowIdx < 0 || count < 3) return { rows: [], headerIdx: -1, cols: 0 };
  const headers = (aoa[rowIdx] || []).map(h => normHeader(h));
  const colMap = {};
  headers.forEach((h, idx) => {
    if(!h) return;
    const field = HEADER_LOOKUP[h];
    if(field && colMap[idx] === undefined) colMap[idx] = field;
  });

  const rows = [];
  for(let r = rowIdx+1; r < aoa.length; r++){
    const row = aoa[r] || [];
    const obj = { id: 'x' + Date.now() + '_' + r + '_' + Math.random().toString(36).slice(2,6) };
    let hasData = false;
    Object.keys(colMap).forEach(idx => {
      const field = colMap[idx];
      let val = row[idx];
      const fdef = FIELDS.find(f => f.k === field);
      if(fdef && fdef.t === 'date') val = excelDateToISO(val);
      else if(fdef && fdef.t === 'number'){
        val = (val===''||val==null||isNaN(parseFloat(val)))?'':String(num(val));
      }
      else val = cleanString(val);
      obj[field] = val;
      if(val !== '' && val != null) hasData = true;
    });
    if(!hasData) continue;
    const deudor = cleanString(obj.nombreDeudor);
    const prestamo = cleanString(obj.noPrestamo);
    const asunto = cleanString(obj.noAsuntoJudicial);
    if(!deudor && !prestamo && !asunto) continue;
    const total = num(obj.montoDemanda) + num(obj.costasTasadas);
    obj.totalRecuperar = total ? total.toFixed(2) : '';
    obj.montoPendiente = total ? (total - num(obj.montoRecuperado)).toFixed(2) : '';
    rows.push(obj);
  }
  return { rows, headerIdx: rowIdx, cols: Object.keys(colMap).length };
}

function openExcelModal(){
  selectedSheet = null; selectedRows = [];
  $('#sheetPick').style.display = 'none';
  $('#previewSummary').style.display = 'none';
  $('#btnConfirmImport').disabled = true;
  $('#dropzone').style.display = 'block';
  $('#excelModal').classList.add('show');
}

function handleExcelFile(file){
  if(!file) return;
  if(file.size > 15 * 1024 * 1024){ toast('⚠ Archivo muy grande (máx 15 MB)'); return; }
  const reader = new FileReader();
  reader.onload = e => {
    try{
      const data = new Uint8Array(e.target.result);
      const wb = XLSX.read(data, { type:'array', cellDates:true });
      const sheets = wb.SheetNames.map(name => {
        const { rows, headerIdx, cols } = sheetToCasos(wb.Sheets[name]);
        return { name, rows, headerIdx, cols };
      });
      sheets.sort((a,b) => (b.rows.length * (b.cols+1)) - (a.rows.length * (a.cols+1)));

      const list = $('#sheetList');
      list.innerHTML = '';
      sheets.forEach(s => {
        const card = document.createElement('div');
        card.className = 'sheet-card';
        const isBest = s.cols >= 5 && s.rows.length > 0;
        card.innerHTML = `
          <div class="n">📄 ${esc(s.name)}</div>
          <div class="m">${s.rows.length} fila(s) · ${s.cols} columna(s) reconocida(s)</div>
          ${isBest ? '<div class="ok">✔ Compatible</div>' : '<div class="m">Datos insuficientes</div>'}
        `;
        if(isBest){ card.addEventListener('click', () => selectSheet(s, card)); card.style.cursor = 'pointer'; }
        else card.style.opacity = '.5';
        list.appendChild(card);
      });

      const best = sheets.find(s => s.cols >= 5 && s.rows.length > 0);
      if(best){
        const card = [...list.children][sheets.indexOf(best)];
        selectSheet(best, card);
      }
      $('#dropzone').style.display = 'none';
      $('#sheetPick').style.display = 'block';
    }catch(err){
      console.error(err);
      alert('No se pudo leer el archivo: ' + err.message);
    }
  };
  reader.readAsArrayBuffer(file);
}

function selectSheet(sheetObj, cardEl){
  [...$('#sheetList').children].forEach(c => c.classList.remove('sel'));
  if(cardEl) cardEl.classList.add('sel');
  selectedSheet = sheetObj.name;
  selectedRows = sheetObj.rows;

  const total = selectedRows.reduce((s,r)=>s+num(r.montoDemanda)+num(r.costasTasadas),0);
  const rec   = selectedRows.reduce((s,r)=>s+num(r.montoRecuperado),0);
  const sucursales = new Set(selectedRows.map(r=>(r.sucursal||'').toUpperCase()).filter(Boolean)).size;
  const abogados = new Set(selectedRows.map(r=>r.abogado).filter(Boolean)).size;

  $('#previewSummary').innerHTML = `
    <div style="font-weight:700;margin-bottom:6px">📊 Vista previa — hoja “${esc(sheetObj.name)}”</div>
    <div class="r"><span>Casos detectados</span><b>${selectedRows.length.toLocaleString('es')}</b></div>
    <div class="r"><span>Columnas reconocidas</span><b>${sheetObj.cols}</b></div>
    <div class="r"><span>Sucursales</span><b>${sucursales}</b></div>
    <div class="r"><span>Abogados</span><b>${abogados}</b></div>
    <div class="r"><span>Total a recuperar</span><b>C$ ${fmtN(total)}</b></div>
    <div class="r"><span>Recuperado</span><b>C$ ${fmtN(rec)}</b></div>
  `;
  $('#previewSummary').style.display = 'block';
  $('#btnConfirmImport').disabled = selectedRows.length === 0;
}

function confirmImport(){
  if(!selectedRows.length) return;
  const reemplazar = casos.length > 0
    ? confirm(`Ya tienes ${casos.length} caso(s).\n\nAceptar = REEMPLAZAR toda la base\nCancelar = AGREGAR los ${selectedRows.length} nuevos`)
    : true;
  if(reemplazar){ casos = selectedRows.slice(); }
  else {
    const ids = new Set(casos.map(c=>c.id));
    selectedRows.forEach(r => {
      if(ids.has(r.id)) r.id = 'x' + Date.now() + '_' + Math.random().toString(36).slice(2,6);
      casos.push(r);
    });
  }
  sucursalSel = null;
  guardar(); render(); renderSucursales(); closeModals();
  toast(`✔ ${selectedRows.length} casos importados desde Excel`);
}

