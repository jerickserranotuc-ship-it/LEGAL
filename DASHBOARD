<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gestor de Casos Judiciales</title>
<script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
<style>
:root{
  --bg:#f4f6fa; --card:#ffffff; --ink:#1a2233; --muted:#6b7690; --line:#e3e8f2;
  --primary:#1e4fd8; --primary-d:#153ba8; --accent:#0f9d78; --danger:#d93b3b;
  --warn:#c98a00; --radius:12px; --shadow:0 2px 12px rgba(20,30,60,.07);
}
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  background:var(--bg);color:var(--ink);font-size:14px}
h1,h2,h3{margin:0}
header{background:linear-gradient(120deg,#122a5e,#1e4fd8);color:#fff;padding:18px 24px;
  display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
header h1{font-size:19px;letter-spacing:.3px;display:flex;align-items:center;gap:10px}
header .sub{font-size:12px;opacity:.85;margin-top:3px}
header .badge-law{background:rgba(255,255,255,.16);padding:6px 12px;border-radius:20px;font-size:12px}
main{max-width:1700px;margin:0 auto;padding:20px 24px 60px}

.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:18px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
  padding:14px 16px;box-shadow:var(--shadow)}
.stat .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);font-weight:600}
.stat .val{font-size:22px;font-weight:700;margin-top:6px}
.stat .val.green{color:var(--accent)} .stat .val.red{color:var(--danger)}
.stat .val.blue{color:var(--primary)} .stat .val.warn{color:var(--warn)}

/* ==== PANEL DE SUCURSALES ==== */
.suc-panel{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
  box-shadow:var(--shadow);margin-bottom:18px;overflow:hidden}
.suc-head{padding:14px 18px;display:flex;justify-content:space-between;align-items:center;
  border-bottom:1px solid var(--line);background:#fbfcfe;flex-wrap:wrap;gap:10px}
.suc-head .t{font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:.6px;color:var(--primary)}
.suc-head .hint{font-size:12px;color:var(--muted)}
.suc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px;padding:16px}
.suc-card{border:1.5px solid var(--line);border-radius:12px;padding:14px;cursor:pointer;
  transition:.18s;background:#fff;position:relative;overflow:hidden}
.suc-card:hover{border-color:var(--primary);background:#f5f8ff;transform:translateY(-2px);
  box-shadow:0 8px 20px rgba(30,79,216,.12)}
.suc-card.sel{border-color:var(--primary);background:linear-gradient(135deg,#e8efff,#f5f8ff);
  box-shadow:0 0 0 3px rgba(30,79,216,.15)}
.suc-card .nom{font-weight:800;font-size:14.5px;color:var(--ink);display:flex;align-items:center;gap:8px}
.suc-card .nom .num{background:var(--primary);color:#fff;font-size:11px;padding:2px 8px;border-radius:10px;font-weight:700}
.suc-card .monto{font-size:18px;font-weight:800;color:var(--primary);margin-top:10px;letter-spacing:-.3px}
.suc-card .monto-l{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);font-weight:700;margin-top:2px}
.suc-card .row{display:flex;justify-content:space-between;font-size:11.5px;margin-top:8px;padding-top:8px;border-top:1px dashed #dde4f3;color:var(--muted)}
.suc-card .row b{color:var(--accent)}
.suc-card .row .red{color:var(--danger)}
.suc-card .bar{height:6px;background:#e8eefb;border-radius:6px;overflow:hidden;margin-top:8px}
.suc-card .bar > i{display:block;height:100%;background:linear-gradient(90deg,#1e4fd8,#0f9d78)}
.suc-card .pct{font-size:11px;font-weight:700;color:var(--accent);margin-top:4px;text-align:right}

/* ==== DETALLE DE SUCURSAL ==== */
.suc-detail{padding:0 16px 20px}
.suc-detail .box{background:#f8faff;border:1px solid #dde4f3;border-radius:12px;padding:16px}
.suc-detail h4{margin:0 0 10px;font-size:12.5px;text-transform:uppercase;letter-spacing:.6px;color:var(--primary)}
.detail-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
.detail-col{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px}
.detail-col .h{font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:800;color:var(--muted);margin-bottom:8px}
.detail-col .item{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px dashed #eef2fb;font-size:12.5px}
.detail-col .item:last-child{border:none}
.detail-col .item b{color:var(--primary)}
.detail-col .item .val{font-weight:700}
.detail-col .item .g{color:var(--accent)} .detail-col .item .r{color:var(--danger)}

.mini-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
.btn.sm{padding:6px 12px;font-size:12.5px}

.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
  box-shadow:var(--shadow);overflow:hidden}
.toolbar{padding:14px 16px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;
  border-bottom:1px solid var(--line);background:#fbfcfe}
input,select,textarea{font-family:inherit;font-size:13.5px;color:var(--ink);
  border:1px solid var(--line);border-radius:8px;padding:8px 10px;background:#fff;outline:none;width:100%}
input:focus,select:focus,textarea:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(30,79,216,.12)}
input[readonly]{background:#f0f3f9;color:var(--muted);font-weight:600}
.toolbar input,.toolbar select{width:auto;min-width:150px}
.toolbar .search{flex:1;min-width:220px}

.btn{border:1px solid transparent;border-radius:8px;padding:8px 14px;font-size:13px;font-weight:600;
  cursor:pointer;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;transition:.15s}
.btn.primary{background:var(--primary);color:#fff}
.btn.primary:hover{background:var(--primary-d)}
.btn.excel{background:#1d6f42;color:#fff}
.btn.excel:hover{background:#175a35}
.btn.ghost{background:#fff;border-color:var(--line);color:var(--ink)}
.btn.ghost:hover{background:#f1f4fa}
.btn.danger{background:#fdecec;color:var(--danger);border-color:#f7cfcf}
.btn.danger:hover{background:#fadada}

.table-wrap{overflow-x:auto;max-height:60vh}
table{border-collapse:collapse;width:100%;min-width:1400px}
th,td{padding:10px 12px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}
th{position:sticky;top:0;background:#f7f9fd;font-size:11px;text-transform:uppercase;
  letter-spacing:.5px;color:var(--muted);cursor:pointer;user-select:none;z-index:2}
th:hover{color:var(--primary)}
th .arw{opacity:.45;font-size:10px}
td{font-size:13px}
tbody tr:hover{background:#f8faff}
.num{text-align:right;font-variant-numeric:tabular-nums}
.badge{display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:700}
.b-activo{background:#e6f7f0;color:#0b7a5c}
.b-tramite{background:#e8efff;color:#1e4fd8}
.b-susp{background:#fff4e0;color:#a06a00}
.b-cerr{background:#eef0f5;color:#5c6579}
.b-peligro{background:#fdecec;color:#c22}
.b-info{background:#e0f2fe;color:#075985}
.actions{display:flex;gap:6px}
.icon-btn{border:1px solid var(--line);background:#fff;border-radius:7px;width:30px;height:30px;
  cursor:pointer;font-size:14px;display:grid;place-items:center;transition:.15s}
.icon-btn:hover{background:#eef3ff;border-color:#c9d8ff}
.empty{padding:50px;text-align:center;color:var(--muted)}

.overlay{position:fixed;inset:0;background:rgba(14,22,45,.55);display:none;
  align-items:flex-start;justify-content:center;padding:26px 16px;z-index:50;overflow-y:auto}
.overlay.show{display:flex}
.modal{background:#fff;border-radius:16px;width:100%;max-width:1080px;box-shadow:0 24px 60px rgba(0,0,0,.3);
  display:flex;flex-direction:column;max-height:calc(100vh - 52px)}
.modal-head{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;
  border-bottom:1px solid var(--line)}
.modal-head h2{font-size:16px}
.modal-body{padding:18px 20px;overflow-y:auto}
.modal-foot{padding:14px 20px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:10px;
  background:#fbfcfe;border-radius:0 0 16px 16px}

.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
.form-section{grid-column:1/-1;font-size:11.5px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;
  color:var(--primary);padding:8px 0 4px;border-bottom:2px solid #e8efff;margin-top:6px}
.form-section:first-child{margin-top:0}
.field{display:flex;flex-direction:column;gap:5px}
.field.full{grid-column:1/-1}
.field label{font-size:11.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
.field .req{color:var(--danger)}

.detail-grid-modal{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0}
.detail-sec{grid-column:1/-1;font-size:11.5px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;
  color:var(--primary);padding:12px 0 6px;border-bottom:2px solid #e8efff;margin-top:4px}
.d-item{padding:9px 12px;border-bottom:1px solid #f0f3f9}
.d-item .k{font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);font-weight:700}
.d-item .v{font-size:13.5px;margin-top:3px;word-break:break-word;white-space:pre-wrap}

.toast{position:fixed;bottom:24px;right:24px;background:#132a56;color:#fff;padding:12px 20px;
  border-radius:10px;font-size:13px;font-weight:600;box-shadow:0 10px 30px rgba(0,0,0,.28);
  opacity:0;transform:translateY(12px);transition:.25s;pointer-events:none;z-index:99}
.toast.show{opacity:1;transform:translateY(0)}

.dropzone{border:2px dashed #c9d8ff;background:#f5f8ff;border-radius:14px;padding:28px;
  text-align:center;transition:.2s;cursor:pointer}
.dropzone:hover,.dropzone.over{border-color:var(--primary);background:#eaf1ff}
.dropzone .big{font-size:38px;margin-bottom:8px}
.dropzone .t{font-weight:700;color:var(--primary);font-size:15px}
.dropzone .s{color:var(--muted);font-size:12.5px;margin-top:6px}

.sheet-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin-top:12px}
.sheet-card{border:1.5px solid var(--line);border-radius:10px;padding:12px;cursor:pointer;
  transition:.15s;background:#fff}
.sheet-card:hover{border-color:var(--primary);background:#f5f8ff}
.sheet-card.sel{border-color:var(--primary);background:#e8efff;box-shadow:0 0 0 3px rgba(30,79,216,.12)}
.sheet-card .n{font-weight:700;font-size:13.5px}
.sheet-card .m{font-size:11.5px;color:var(--muted);margin-top:4px}
.sheet-card .ok{color:var(--accent);font-weight:700;font-size:11px}

.summary{background:#f5f8ff;border:1px solid #d6e2ff;border-radius:10px;padding:14px;margin-top:14px}
.summary .r{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px dashed #d6e2ff;font-size:13px}
.summary .r:last-child{border:none}
.summary .r b{color:var(--primary)}
</style>
</head>
<body>

<header>
  <div>
    <h1>⚖️ Gestor de Casos Judiciales</h1>
    <div class="sub">Control de cartera judicial · seguimiento procesal y recuperación</div>
  </div>
  <div class="badge-law" id="headerCount">0 casos</div>
</header>

<main>
  <!-- ESTADÍSTICAS GLOBALES -->
  <section class="stats">
    <div class="stat"><div class="lbl">Casos registrados</div><div class="val blue" id="sCasos">0</div></div>
    <div class="stat"><div class="lbl">Monto demandado</div><div class="val" id="sDemanda">0.00</div></div>
    <div class="stat"><div class="lbl">Total a recuperar</div><div class="val" id="sTotal">0.00</div></div>
    <div class="stat"><div class="lbl">Recuperado</div><div class="val green" id="sRecup">0.00</div></div>
    <div class="stat"><div class="lbl">Pendiente</div><div class="val red" id="sPend">0.00</div></div>
    <div class="stat"><div class="lbl">% Recuperación</div><div class="val" id="sPct">0%</div></div>
  </section>

  <!-- PANEL DE SUCURSALES -->
  <section class="suc-panel">
    <div class="suc-head">
      <div class="t">🏢 Sucursales — clic para ver detalle completo</div>
      <div class="hint" id="sucHint">Selecciona una sucursal para desplegar toda su información</div>
    </div>
    <div class="suc-grid" id="sucGrid"></div>
    <div class="suc-detail" id="sucDetail" style="display:none"></div>
  </section>

  <!-- TABLA PRINCIPAL -->
  <section class="panel">
    <div class="toolbar">
      <input class="search" id="search" type="search" placeholder="🔎 Buscar por deudor, cédula, préstamo, asunto, juzgado...">
      <select id="filterEstatus"><option value="">Estatus: todos</option></select>
      <select id="filterAbogado"><option value="">Abogado: todos</option></select>
      <select id="filterSucursal"><option value="">Sucursal: todas</option></select>
      <button class="btn excel" id="btnExcel">📥 Importar Excel</button>
      <button class="btn primary" id="btnNuevo">＋ Nuevo caso</button>
      <button class="btn ghost" id="btnCSV">⬇ CSV</button>
      <button class="btn ghost" id="btnJSON">⬇ Respaldo</button>
      <button class="btn ghost" id="btnImportJSON">⬆ JSON</button>
      <button class="btn danger" id="btnBorrarTodo">🗑 Todo</button>
      <input type="file" id="fileExcel" accept=".xlsx,.xls,.csv" hidden>
      <input type="file" id="fileImportJSON" accept=".json" hidden>
    </div>

    <div class="table-wrap">
      <table id="tabla">
        <thead><tr id="theadRow"></tr></thead>
        <tbody id="tbody"></tbody>
      </table>
      <div class="empty" id="emptyMsg">No hay casos registrados. Presiona <b>📥 Importar Excel</b> o <b>＋ Nuevo caso</b>.</div>
    </div>
  </section>
</main>

<!-- MODAL EXCEL -->
<div class="overlay" id="excelModal">
  <div class="modal">
    <div class="modal-head">
      <h2>📥 Importar base de Excel</h2>
      <button class="icon-btn" data-close>✕</button>
    </div>
    <div class="modal-body" id="excelBody">
      <div class="dropzone" id="dropzone">
        <div class="big">📄</div>
        <div class="t">Arrastra tu archivo Excel aquí o haz clic para seleccionar</div>
        <div class="s">Formatos soportados: .xlsx, .xls, .csv — máx. recomendado 15 MB</div>
      </div>
      <div id="sheetPick" style="display:none">
        <h3 style="font-size:14px;margin-bottom:4px">Selecciona la hoja con los datos</h3>
        <div class="s" style="color:var(--muted);font-size:12.5px">Las hojas con más encabezados reconocidos aparecen marcadas con ✔</div>
        <div class="sheet-list" id="sheetList"></div>
        <div class="summary" id="previewSummary" style="display:none"></div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn ghost" data-close>Cancelar</button>
      <button class="btn primary" id="btnConfirmImport" disabled>Importar datos</button>
    </div>
  </div>
</div>

<!-- MODAL FORM -->
<div class="overlay" id="formModal">
  <div class="modal">
    <div class="modal-head">
      <h2 id="formTitle">Nuevo caso</h2>
      <button class="icon-btn" data-close>✕</button>
    </div>
    <form class="modal-body form-grid" id="casoForm" autocomplete="off"></form>
    <div class="modal-foot">
      <button class="btn ghost" data-close>Cancelar</button>
      <button class="btn primary" id="saveBtn">💾 Guardar caso</button>
    </div>
  </div>
</div>

<!-- MODAL DETALLE -->
<div class="overlay" id="viewModal">
  <div class="modal">
    <div class="modal-head">
      <h2 id="viewTitle">Detalle del caso</h2>
      <button class="icon-btn" data-close>✕</button>
    </div>
    <div class="modal-body"><div class="detail-grid-modal" id="viewBody"></div></div>
    <div class="modal-foot">
      <button class="btn ghost" data-close>Cerrar</button>
      <button class="btn primary" id="viewEdit">✎ Editar este caso</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ============================================================
   CAMPOS (exactamente los que solicitaste)
   ============================================================ */
const FIELDS = [
  {k:'noPrestamo',        l:'No. Préstamo',              t:'text', sec:'Cartera y préstamo'},
  {k:'estadoCartera',     l:'Estado de la cartera',      t:'select', sec:'Cartera y préstamo',
     opts:['Vigente','Vencida','Judicial','Castigada','Cancelada','Reestructurada','Saneada','Corriente']},
  {k:'sucursal',          l:'Sucursal',                  t:'text', sec:'Cartera y préstamo'},
  {k:'fUltimoPago',       l:'F. último pago',            t:'date', sec:'Cartera y préstamo'},
  {k:'fechaUltimoPago',   l:'Fecha último pago',         t:'date', sec:'Cartera y préstamo'},

  {k:'nombreDeudor',      l:'Nombre del deudor',         t:'text', sec:'Deudor y fiadores', req:true},
  {k:'cedulaDeudor',      l:'Cédula deudor',             t:'text', sec:'Deudor y fiadores'},
  {k:'cedulaDeudor2',     l:'Cédula deudor 2',           t:'text', sec:'Deudor y fiadores'},
  {k:'nombreFiadores',    l:'Nombre del fiador(es)',     t:'textarea', sec:'Deudor y fiadores'},
  {k:'cedulaFiador',      l:'Cédula fiador',             t:'text', sec:'Deudor y fiadores'},

  {k:'tipoJuicio',        l:'Tipo de juicio',            t:'select', sec:'Proceso judicial',
     opts:['Ejecutivo','Ejecutivo Hipotecario','Ejecutivo Prendario','Ordinario','Sumario','Monitorio','Laboral',
           'EJECUCION DE TITULO NO JUDICIAL','Otro']},
  {k:'fechaPresentacionDemanda', l:'Fecha de presentación de demanda', t:'date', sec:'Proceso judicial'},
  {k:'juzgado',           l:'Juzgado',                   t:'text', sec:'Proceso judicial'},
  {k:'noAsuntoJudicial',  l:'No. Asunto judicial',       t:'text', sec:'Proceso judicial'},

  {k:'fechaUltimaGestion',l:'Fecha última gestión',      t:'date', sec:'Gestión y seguimiento'},
  {k:'gestionProcesal',   l:'Gestión procesal realizada',t:'textarea', sec:'Gestión y seguimiento'},
  {k:'accionEjecutar',    l:'Acción a ejecutar',         t:'textarea', sec:'Gestión y seguimiento'},
  {k:'estatus',           l:'Estatus',                   t:'select', sec:'Gestión y seguimiento',
     opts:['Activo','En trámite','Suspendido','Sentencia favorable','Embargo','Ejecución','Apelación',
           'Cerrado','Archivado','CANCELADO','Cancelado','RECUPERANDO','Recuperando','NO LABORA',
           'Pendiente de recuperar','Pendiente de embargo','Pendiente tasar costas']},
  {k:'lugarEmbargo',      l:'Lugar de embargo',          t:'text', sec:'Gestión y seguimiento'},

  {k:'montoDemanda',      l:'Monto de la demanda',       t:'number', sec:'Recuperación económica'},
  {k:'costasTasadas',     l:'Costas tasadas',            t:'number', sec:'Recuperación económica'},
  {k:'totalRecuperar',    l:'Total a recuperar (auto)',  t:'number', sec:'Recuperación económica', readonly:true},
  {k:'montoRecuperado',   l:'Monto recuperado a la fecha', t:'number', sec:'Recuperación económica'},
  {k:'montoPendiente',    l:'Monto pendiente de recuperar (auto)', t:'number', sec:'Recuperación económica', readonly:true},

  {k:'trabajoActual',     l:'Trabajo actual',            t:'text', sec:'Empleo y abogado'},
  {k:'salario',           l:'Salario',                   t:'number', sec:'Empleo y abogado'},
  {k:'statusTrabajo',     l:'Status trabajo',            t:'select', sec:'Empleo y abogado',
     opts:['Activo','Inactivo','Desconocido','Jubilado','Fallecido','Sin empleo','LABORANDO-D','NO LABORA-D']},
  {k:'abogado',           l:'Abogado',                   t:'text', sec:'Empleo y abogado'}
];

const COLS = [
  {k:'noPrestamo',        l:'No. Préstamo'},
  {k:'nombreDeudor',      l:'Deudor'},
  {k:'cedulaDeudor',      l:'Cédula'},
  {k:'sucursal',          l:'Sucursal'},
  {k:'tipoJuicio',        l:'Tipo de juicio'},
  {k:'noAsuntoJudicial',  l:'No. Asunto'},
  {k:'juzgado',           l:'Juzgado'},
  {k:'fechaUltimaGestion',l:'Últ. gestión', date:true},
  {k:'estatus',           l:'Estatus', badge:true},
  {k:'montoDemanda',      l:'Monto demanda', money:true},
  {k:'montoRecuperado',   l:'Recuperado', money:true},
  {k:'_pendiente',        l:'Pendiente', money:true},
  {k:'abogado',           l:'Abogado'}
];

const FIELD_ALIASES = {
  noPrestamo:['PRESTAMO','NO PRESTAMO','N PRESTAMO','NUMERO PRESTAMO','NO. PRESTAMO'],
  estadoCartera:['ESTADO DE LA CARTERA','ESTADO CARTERA'],
  sucursal:['SUCURSAL'],
  nombreDeudor:['NOMBRE DEL DEUDOR','NOMBRE DEUDOR','DEUDOR'],
  fUltimoPago:['F.ULTIMO PAGO','F ULTIMO PAGO','FECHA ULTIMO PAGO'],
  fechaUltimoPago:['FECHA ULTIMO PAGO'],
  cedulaDeudor:['CEDULA DEUDOR','CEDULA DEL DEUDOR'],
  nombreFiadores:['NOMBRE DEL FIADOR (ES)','NOMBRE DEL FIADOR','NOMBRE FIADOR (ES)','NOMBRE FIADORES','FIADOR (ES)'],
  cedulaFiador:['CEDULA FIADOR','CEDULA DEL FIADOR'],
