const $  = s => document.querySelector(s);
const LS_KEY = 'gestor_casos_judiciales_v3';
let casos = [], editId = null, sortKey = null, sortDir = 1, viewId = null;
let sucursalSel = null;
let selectedSheet = null, selectedRows = [];

const num = v => { if(v===null||v===undefined||v==='') return 0; const n = parseFloat(String(v).replace(/[^\d.\-]/g,'')); return isNaN(n) ? 0 : n; };
const fmtN = n => num(n).toLocaleString('es', {minimumFractionDigits:2, maximumFractionDigits:2});
const fmtNI = n => num(n).toLocaleString('es');
const fmtDate = d => { if(!d) return '—'; const p = String(d).split('T')[0].split('-'); return p.length===3 ? `${p[2]}/${p[1]}/${p[0]}` : d; };
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

function toast(msg, ms=2400){
  const t = $('#toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(t._t); t._t = setTimeout(()=>t.classList.remove('show'), ms);
}
function calc(c){
  const md = num(c.montoDemanda), ct = num(c.costasTasadas), mr = num(c.montoRecuperado);
  const total = md + ct;
  return { total, pendiente: total - mr, md, ct, mr };
}
function badgeClass(e){
  const s = (e||'').toLowerCase();
  if(s.includes('cancel')||s.includes('cerr')||s.includes('archiv')) return 'b-cerr';
  if(s.includes('suspend')||s.includes('apelac')) return 'b-susp';
  if(s.includes('activo')||s.includes('trámite')||s.includes('tramite')) return 'b-tramite';
  if(s.includes('embargo')||s.includes('ejecuc')||s.includes('recuper')) return 'b-activo';
  if(s.includes('no labora')||s.includes('pendiente')) return 'b-peligro';
  return 'b-cerr';
}

function guardar(){ try{ localStorage.setItem(LS_KEY, JSON.stringify(casos)); }catch(e){ console.warn(e); } }
function cargar(){ try{ casos = JSON.parse(localStorage.getItem(LS_KEY)) || []; }catch(e){ casos = []; } }

